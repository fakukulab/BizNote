    "eventMode.consent.defaultText" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The personal information you provide will be used only for lead management at this event, and will be kept secure unless you request otherwise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ご入力いただいた個人情報は、本イベントのリード管理の目的にのみ使用され、特にご要望がない限り安全に保管されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Сіз берген жеке деректер тек осы іс-шараның клиенттермен жұмыс мақсатында пайдаланылады және сіз өзгеше сұратпаса, қауіпсіз сақталады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "입력하신 개인정보는 본 행사의 리드 관리 목적으로만 사용되며, 별도 요청이 없는 한 안전하게 보관됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Предоставленные вами персональные данные будут использоваться только для управления контактами в рамках этого мероприятия и будут надёжно храниться, если вы не укажете иное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "您提供的个人信息仅用于本次活动的潜在客户管理目的，在您没有另行要求的情况下将被安全保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "您提供的個人資料僅用於本次活動的名單管理目的，在您未另行要求的情況下將被安全保存。"
          }
        }
      }
    },
